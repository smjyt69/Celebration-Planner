# Copy to .env for reference and set these in your shell or hosting provider.
# The app reads real environment variables; it does not load .env automatically.

# Optional: enables AI-written ideas and answers. Without it the built-in engine answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

PORT=5000
# Set to 1 only when running behind a reverse proxy you control (so client IPs are read correctly).
TRUST_PROXY=0
